#!/usr/bin/env python3
"""Refuse a commit whose staged C sources are not clang-format clean.

R-RPO-06 puts every hook here, in Python 3, so one set runs on Windows and
Linux. Point git at it once:

    git config core.hooksPath docs/.githooks

R-FMT-01 is the rule this enforces: formatting is not a review topic, so it
must not be able to reach review.
"""

from __future__ import annotations

import shutil
import subprocess
import sys

SOURCE_PREFIXES = ("application/", "middleware/", "driver/")


def staged_sources() -> list[str]:
    out = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                         capture_output=True, text=True, check=True).stdout
    return [p for p in out.splitlines()
            if p.startswith(SOURCE_PREFIXES) and p.endswith((".c", ".h"))]


def main() -> int:
    files = staged_sources()
    if not files:
        return 0

    if shutil.which("clang-format") is None:
        print("pre-commit: clang-format not on PATH, skipping the format check")
        return 0

    result = subprocess.run(["clang-format", "--dry-run", "--Werror", *files])
    if result.returncode != 0:
        print("")
        print("pre-commit: staged sources are not formatted (R-FMT-01).")
        print("  fix: python docs/scripts/tool-esp.py format")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
